diff --git a/simfoundry/models/sam_v3_gmask.py b/simfoundry/models/sam_v3_gmask.py
index a749dfe..8d5966b 100644
--- a/simfoundry/models/sam_v3_gmask.py
+++ b/simfoundry/models/sam_v3_gmask.py
@@ -475,3 +475,11 @@ class SAM3(torch.nn.Module):
         updated_masks = [mask & keep_mask for mask, keep_mask in zip(masks, keep_masks)]
 
         return updated_masks
+
+
+# SIMFOUNDRY_SEGMENTER=sam2-bedrock swaps in SAM 2.1 grounded by Claude, for when the gated SAM 3
+# weights aren't available.
+from simfoundry.models.sam2_grounded import make_sam2_grounded, segmenter_swapped  # noqa: E402
+
+if segmenter_swapped():
+    SAM3 = make_sam2_grounded(SAM3)  # noqa: F811
