         updated_masks = [mask & keep_mask for mask, keep_mask in zip(masks, keep_masks)]
 
         return updated_masks
+
+
+# SIMFOUNDRY_SEGMENTER=sam2-bedrock swaps in SAM 2.1 grounded by Claude. It extends sam_v3_gmask's
