; NPT equilibration parameters for GROMACS
; Pressure equilibration at 300K/1bar with position restraints

define      = -DPOSRES      ; Position restraints on protein

; Run parameters
integrator  = md            ; Leap-frog integrator
nsteps      = 50000         ; 100 ps (2fs * 50000)
dt          = 0.002         ; 2 fs timestep

; Output control
nstxout-compressed  = 5000  ; Write compressed coords every 10 ps
nstlog              = 5000  ; Update log file every 10 ps
nstenergy           = 5000  ; Save energies every 10 ps

; Bond parameters
continuation    = yes       ; Continuing from NVT
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4

; Neighbor searching
nstlist         = 10
cutoff-scheme   = Verlet
ns_type         = grid
rcoulomb        = 1.0
rvdw            = 1.0

; Electrostatics
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16

; Temperature coupling
tcoupl      = V-rescale
tc-grps     = Protein Non-Protein
tau_t       = 0.1     0.1
ref_t       = 300     300

; Pressure coupling
pcoupl          = Parrinello-Rahman  ; Pressure coupling
pcoupltype      = isotropic          ; Uniform scaling
tau_p           = 2.0                ; Time constant (ps)
ref_p           = 1.0                ; Reference pressure (bar)
compressibility = 4.5e-5             ; Isothermal compressibility of water

; Periodic boundary conditions
pbc         = xyz

; Velocity generation
gen_vel     = no            ; Velocities from NVT equilibration
